{
    "@context": [
        "https://www.w3.org/2022/wot/td/v1.1",
        {
            "htv": "http://www.w3.org/2011/http#"
        }
    ],
    "title": "httpJsonWriteApi",
    "securityDefinitions": {
        "nosec_sc": {
            "scheme": "nosec"
        }
    },
    "security": [
        "nosec_sc"
    ],
    "properties": {
        "writeConfig": {
            "type": "object",
            "writeOnly": true,
            "description": "Writes JSON to an HTTP endpoint.",
            "forms": [
                {
                    "href": "http://127.0.0.1:0/config",
                    "contentType": "application/json",
                    "htv:methodName": "PUT"
                }
            ]
        }
    }
}
