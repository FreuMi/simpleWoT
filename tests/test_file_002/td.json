{
    "@context": [
        "https://www.w3.org/2022/wot/td/v1.1"
    ],
    "title": "localFileApi",
    "securityDefinitions": {
        "nosec_sc": {
            "scheme": "nosec"
        }
    },
    "security": [
        "nosec_sc"
    ],
    "properties": {
        "readConfig": {
            "type": "string",
            "readOnly": true,
            "description": "Returns the current content of test_file.",
            "forms": [
                {
                    "href": "./test_file",
                    "contentType": "text/plain"
                }
            ]
        },
        "writeConfig": {
            "type": "string",
            "writeOnly": true,
            "description": "Overrides the content of test_file.",
            "forms": [
                {
                    "href": "./test_file",
                    "contentType": "text/plain"
                }
            ]
        }
    }
}
